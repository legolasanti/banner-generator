# Copy to .env and fill in. .env is never committed.

# OpenRouter (AI mode in Native Premium). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Google API key with the Drive API enabled. Without it, shared
# Drive folders are read through Google's public folder view (names only).
GOOGLE_API_KEY=

# Optional: logins. Off when empty. Create users with: npm run user:add
# AUTH=on
# SESSION_SECRET=   (long random string; generated into data/ if empty)

# PORT=4050
